#!/bin/sh
# nfvis 安装后脚本（M5-10，FR-OPS-013）：目录/权限、底座优化校验、core_pattern、systemd 装载。
# 设计原则：**校验与提示为主，不阻断安装**（底座差异不应让 dpkg 失败）；幂等，可重复执行。
set -e

log() { echo "nfvis postinst: $*"; }

# 1) 数据目录（决策 #45/#56/#57/#59 的落点）
install -d -m 0755 /var/lib/nfvis
for d in images backup captures coredumps tech-support vms; do
    install -d -m 0755 "/var/lib/nfvis/$d"
done
install -d -m 0755 /data/incoming
install -d -m 0755 /run/nfvis
# VPP 创建的 vhost-user/memif socket 需 QEMU/容器可访问（M4 技术坑 #4）
install -d -m 0777 /run/nfvis/vhost /run/nfvis/memif

# 2) core dump 收集（FR-OPS-041）：若当前 core_pattern 未指向 nfvis 目录且非 systemd-coredump，
#    提示管理员（不擅自改内核参数，避免影响其它服务）；安装了 systemd-coredump 的场景由收集器落盘。
CORE_DIR=/var/lib/nfvis/coredumps
CURRENT_CP=$(cat /proc/sys/kernel/core_pattern 2>/dev/null || true)
case "$CURRENT_CP" in
    "$CORE_DIR"*) log "core_pattern 已指向 $CORE_DIR" ;;
    *systemd-coredump*|"|"*apport*) log "提示：core_pattern 走系统收集器（$CURRENT_CP）；如需 nfvis 目录收集，可执行：echo '$CORE_DIR/core.%e.%p.%t' > /proc/sys/kernel/core_pattern" ;;
    *) log "提示：core_pattern=$CURRENT_CP 未指向 $CORE_DIR，core dump 清单可能为空" ;;
esac

# 3) 底座优化校验（FR-SYS-002/003、FR-SEC-006）——仅提示
# 只看 **1G 页池**：/proc/meminfo 的 HugePages_Total 是**各尺寸合计**，
# 而 Ubuntu 默认就预留了 1024 个 2M 页 → 用它会误报「大页已预留」（实际没有 1G 池，
# VNF 内存分配仍会失败）。1G 池以 sysfs 的 hugepages-1048576kB 为准。
HP1G_TOTAL=$(cat /sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages 2>/dev/null || echo 0)
HP1G_FREE=$(cat /sys/kernel/mm/hugepages/hugepages-1048576kB/free_hugepages 2>/dev/null || echo 0)
HP2M_TOTAL=$(cat /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages 2>/dev/null || echo 0)
if [ "${HP1G_TOTAL:-0}" -gt 0 ] 2>/dev/null; then
    log "1G 大页池已预留：total=${HP1G_TOTAL} free=${HP1G_FREE}"
else
    log "提示：未检测到 **1G** 大页池（当前 1G=${HP1G_TOTAL:-0}、2M=${HP2M_TOTAL:-0}）。"
    log "      VNF 内存从 1G 大页池分配，未预留则 VM 无法启动。"
    log "      处理：重启生效；如需自定义，登录 CLI 执行 wizard（见用户手册「3.1 内核基线」）。"
fi
if grep -q 'isolcpus' /proc/cmdline 2>/dev/null; then
    log "isolcpus 已配置：$(tr ' ' '\n' < /proc/cmdline | grep isolcpus | tr '\n' ' ')"
else
    log "提示：内核命令行未见 isolcpus（隔离核基线未应用）"
fi

# 4) 运行依赖探测（仅提示）
for comp in vpp libvirtd dockerd; do
    if command -v "$comp" >/dev/null 2>&1 || systemctl list-unit-files 2>/dev/null | grep -q "^${comp}\.service"; then
        log "检测到 $comp"
    else
        log "警告：未检测到 $comp（对应编排能力将降级）"
    fi
done

# 5) systemd 单元（FR-OPS-013：Restart=always + WatchdogSec）
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable nfvis.service >/dev/null 2>&1 || true
    # FR-OPS-001：升级时自动重启已在运行的 nfvisd 以加载新版本（未运行则不影响，
    # 避免安装期抢占网卡——首次安装不自动 start）。
    if [ "$1" = "configure" ] && [ -n "$2" ]; then
        systemctl try-restart nfvis.service >/dev/null 2>&1 && log "已重启 nfvis.service 以加载新版本" || true
    fi
    log "已装载 nfvis.service（enable；首次安装不自动 start——按需 systemctl start nfvis）"
fi

# 6) 内核启动基线（FR-SYS-014 / FR-CMP-005）：无基线则按机器规格应用保守默认（安装期预置），
#    已有基线则仅检查报告。**校验/应用失败不阻断安装**（底座差异不应让 dpkg 失败）。
BASELINE_SH=/usr/share/nfvis/installer/nfvis-baseline.sh
if [ -x "$BASELINE_SH" ]; then
    if [ -f /etc/default/grub.d/99-nfvis.cfg ]; then
        sh "$BASELINE_SH" --check || true
    else
        log "未检测到内核基线，按机器规格应用保守默认（1G 大页 = min(RAM/4, 8)，不设 isolcpus）"
        if [ -x /usr/bin/nfvisd ]; then
            sh "$BASELINE_SH" --defaults || log "提示：自动应用基线失败，可稍后手工执行 $BASELINE_SH --defaults"
        else
            log "提示：nfvisd 尚未安装，跳过基线应用；安装完成后执行 $BASELINE_SH --defaults"
        fi
        log "注意：内核基线需重启生效"
    fi
fi

# 7) SSH 强化（FR-SEC-006）：禁用 root **口令**登录（root 密钥登录保留）。
#    安全性由脚本自己把关：**只写 drop-in + sshd -t 校验，不重启 sshd**（下一次 sshd 启动才生效），
#    且**找不到密钥登录路径时主动跳过**（否则一重启 sshd 就再也进不来）。失败不阻断安装。
SSH_HARDEN=/usr/share/nfvis/installer/nfvis-ssh-harden.sh
if [ -x "$SSH_HARDEN" ]; then
    sh "$SSH_HARDEN" --apply || log "提示：SSH 强化未完成（见上方输出）；可稍后执行 $SSH_HARDEN --apply 重试"
fi
exit 0
