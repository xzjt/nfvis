#!/bin/sh
# nfvis 卸载前脚本。
#
# **升级时不停止服务**：若在此停止，postinst 的 `systemctl try-restart` 会因为
# "未在运行" 而变成空操作，升级完 nfvisd 就一直是停的（FR-OPS-001 的"升级后自动
# 重启以加载新版本"落空）。让旧进程继续跑，由 postinst try-restart 负责换成新二进制。
# 真正卸载（remove/deconfigure）时才停止。
set -e
case "$1" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop nfvis.service >/dev/null 2>&1 || true
            echo "nfvis prerm: 已停止 nfvis.service（$1）"
        fi
        # 还原 vpp 包的 sysctl conffile（决策 #201）：接管是 nfvis 装出来的，
        # 卸载后必须把它放回去，否则 vpp 那个文件会永久消失（vpp 之后升级也写不回原位）。
        # 本文件同时是「卸载时清理自己在系统里留下的痕迹」的落点。
        if command -v dpkg-divert >/dev/null 2>&1 \
                && dpkg-divert --list /etc/sysctl.d/80-vpp.conf 2>/dev/null | grep -q /etc/sysctl.d/80-vpp.conf; then
            if dpkg-divert --package nfvis --remove --rename /etc/sysctl.d/80-vpp.conf >/dev/null 2>&1; then
                echo "nfvis prerm: 已还原 /etc/sysctl.d/80-vpp.conf（vpp 包自带的 sysctl 恢复原位）"
            else
                echo "nfvis prerm: 提示：还原 /etc/sysctl.d/80-vpp.conf 失败（可手工 dpkg-divert --remove --rename）" >&2
            fi
        fi
        ;;
    upgrade)
        echo "nfvis prerm: 升级中，保留运行中的 nfvis.service（由 postinst try-restart 换新版本）"
        ;;
esac
exit 0
