#!/bin/sh
# nfvis 卸载后：purge 时清理运行态目录、**撤销安装期对底座做的改动**；
# 配置/镜像/备份等数据**不自动删除**（避免误删，恢复出厂由 zeroize 显式执行）。
#
# 为什么要撤销底座改动（发现 #1，2026-09-18 裸机实测）：`dpkg --purge` 之后系统仍留着
#   ① /etc/ssh/sshd_config.d/99-nfvis.conf —— 卸载后 SSH 仍被限制（安全相关的"看不见的开关"）；
#   ② /etc/default/grub.d/99-nfvis.cfg + /etc/fstab 大页行 —— 系统仍带着为 NFViS 调过的启动参数/挂载。
# ① 由本脚本自动撤销（幂等、无副作用）；② 涉及 re-generate 启动配置与动 /etc/fstab，
# 卸载过程**不自动改**，只打印可照着做的撤销步骤（不留"看不见的痕迹"）。
set -e

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    if [ "$1" = "purge" ]; then
        systemctl disable nfvis.service >/dev/null 2>&1 || true
    fi
fi

if [ "$1" = "purge" ]; then
    rm -rf /run/nfvis
    echo "nfvis postrm: 已清理 /run/nfvis（/var/lib/nfvis 数据保留）"

    # ① SSH 强化：撤销 drop-in（它会让卸载后的系统继续禁止 root 口令登录）。
    # **必须内联**：postrm 运行时包文件已被删除（dpkg 先删文件再跑 postrm），
    # 不能依赖包内脚本——发现 #28：[ -x ] 静默跳过使撤销从未生效（round20 的
    # 验证用探针路径，未覆盖「包文件已删」的真实时序）。撤销只是移除限制
    # （恢复 sshd 默认），无锁死风险，故无需 ssh-harden 的闸门；删后 sshd -t 校验再 reload。
    if [ -f /etc/ssh/sshd_config.d/99-nfvis.conf ]; then
        rm -f /etc/ssh/sshd_config.d/99-nfvis.conf
        if command -v sshd >/dev/null 2>&1 && sshd -t 2>/dev/null; then
            if systemctl reload sshd >/dev/null 2>&1 || systemctl restart sshd >/dev/null 2>&1; then
                echo "nfvis postrm: 已撤销 SSH 强化（/etc/ssh/sshd_config.d/99-nfvis.conf 已删、sshd 已重载）"
            else
                echo "nfvis postrm: drop-in 已删除；sshd 重载失败，请手工执行 systemctl reload sshd"
            fi
        else
            echo "nfvis postrm: drop-in 已删除；sshd 不可用或校验失败，重启后按 sshd 默认配置生效"
        fi
    fi

    # ② 内核基线：不自动改，给出可照做的步骤
    echo "nfvis postrm: 以下安装期改动**仍需手工撤销**（重启后才彻底生效）："
    echo "  · /etc/default/grub.d/99-nfvis.cfg（大页/隔离核等启动参数）"
    echo "      手工：rm -f /etc/default/grub.d/99-nfvis.cfg && update-grub"
    echo "  · /etc/fstab 里带 '# nfvis-hugepages' 标记的挂载行"
    echo "      手工：删掉该标记行及其下一行（hugetlbfs 挂载）后 umount /dev/hugepages"
fi
exit 0
