[Unit]
Description=NFViS 一体机守护进程（nfvisd）
# 文档目录（ASCII 路径）。注意：systemd 的 Documentation= 要求**合法 URL**，
# 而 /usr/share/doc/nfvis 下的文档文件名含中文 → 直接写文件名会被判
# “Invalid URL, ignoring”。故指向目录本身。
Documentation=file:///usr/share/doc/nfvis/
After=network-online.target libvirtd.service docker.service vpp.service
Wants=network-online.target
# VPP/libvirtd/docker 由 nfvisd 编排；任一未起时 nfvisd 降级运行（FR-OPS-010/013）
After=vpp.service
# FR-OPS-013：连续快速崩溃退避（StartLimit* 属 [Unit] 段——放 [Service] 会被
# systemd 判为 “Unknown key … in section [Service], ignoring” 而**静默失效**）
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
# FR-OPS-013：崩溃自动拉起 + 看门狗
Restart=always
RestartSec=3
WatchdogSec=30
Environment=NFVIS_DB=/var/lib/nfvis/nfvis.db
Environment=NFVIS_LISTEN=:443
Environment=NFVIS_VPP_SOCK=/run/vpp/api.sock
# FR-SEC-004（决策 #72）：未提供证书时 nfvisd 自动生成自签证书并启用 HTTPS；
# 明文仅由 -allow-plaintext 显式开启（开发/测试）。生产可用 set system api tls 安装正式证书。
# FR-SEC-001：NFVIS_LISTEN 为通配时，nfvisd 按 committed 管理口地址收敛绑定地址。
ExecStart=/usr/bin/nfvisd -db ${NFVIS_DB} -listen ${NFVIS_LISTEN} -vpp-sock ${NFVIS_VPP_SOCK}
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=30
# 底座交互需要 root（VPP socket / libvirt / docker / sysfs）
User=root
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
