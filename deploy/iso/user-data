#cloud-config
# NFViS 安装 ISO 的 autoinstall seed（决策 #110）。
# __NFVIS_PASSWORD_HASH__ 由 contrib/iso/build-iso.sh 在构建时替换为 NFVIS_PASSWORD
# 的 crypt(6) 哈希——仓库不落口令哈希，避免哈希随源码漂移。
autoinstall:
  version: 1
  # 全自动：任何报错都应以错误告终而不是落入交互界面等着人发现（装机"卡住"比失败更难排查）
  interactive-sections: []
  locale: en_US.UTF-8
  keyboard:
    layout: us
  # 气隙安装：镜像不可达时从安装介质离线补齐（26.04 起这也是缺省行为，显式写出防漂移）
  apt:
    fallback: offline-install
  identity:
    hostname: nfvis
    username: nfvis
    password: "__NFVIS_PASSWORD_HASH__"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    # 直接分区（无 LVM）；缺省装到最大盘
    layout:
      name: direct
  shutdown: reboot
  late-commands:
    # deb 闭包随盘落位 /opt/nfvis/debs：装机源（本地 file 仓库）+ 留在系统里的气隙修复源
    #（cp 不建中间目录，/opt/nfvis 须先建——round32 第三次装机实测）
    - mkdir -p /target/opt/nfvis
    - cp -a /cdrom/nfvis/debs /target/opt/nfvis/debs
    # 只认本地仓库（SourceList 覆盖 + 关闭 SourceParts，网络源在气隙下不可达也不去碰）
    - printf 'deb [trusted=yes] file:/opt/nfvis/debs ./\n' > /target/etc/apt/sources.list.d/nfvis-local.list
    - curtin in-target -- sh -c 'apt-get update -o Dir::Etc::sourcelist=sources.list.d/nfvis-local.list -o Dir::Etc::sourceparts=-'
    # apt 解析安装种子集：候选组/互斥变体/已装同旧版本都由 apt 挑选跳过（dpkg 直灌已被
    # round32 两次证伪）；闭包只含 Depends（补齐时即排除 Recommends），这里对齐口径
    - curtin in-target -- sh -c 'env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o Dir::Etc::sourcelist=sources.list.d/nfvis-local.list -o Dir::Etc::sourceparts=- /opt/nfvis/debs/nfvis_*.deb /opt/nfvis/debs/vpp*.deb /opt/nfvis/debs/libvppinfra*.deb docker.io libvirt-daemon-system libvirt-clients qemu-system-x86 qemu-utils cloud-image-utils >/var/log/nfvis-apt-install.log 2>&1 || { tail -60 /var/log/nfvis-apt-install.log >&2; exit 1; }'
    # 首次开机不自启 VPP：业务口声明（startup.conf）须由 nfvisd 掌握后经 request vpp restart 启动；
    # nfvis.service 只 After= 不 Requires=，VPP 未起时 nfvisd 降级运行
    - curtin in-target -- systemctl disable vpp.service
    # 串口控制台（无头/气隙 appliance 的管理面）：装机期选中的就是串口可视条目，
    # 装好的系统保持同一口径才能继续经串口登录运维；写独立 drop-in，不碰产品托管的 99-nfvis.cfg
    - printf 'GRUB_CMDLINE_LINUX="console=tty1 console=ttyS0,115200n8"\n' > /target/etc/default/grub.d/50-nfvis-iso-console.cfg
    # nfvis postinst 的 --defaults 已写 /etc/default/grub.d/99-nfvis.cfg（1G 大页保守默认）；
    # curtin 装引导先于 late-commands，故最后补一次 update-grub 把两个 drop-in 写进引导配置，首次开机即生效
    - curtin in-target -- update-grub
